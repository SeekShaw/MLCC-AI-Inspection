%% EcompVision Inspector 工作流程图（Mermaid 源，纯文本可编辑）
%% 逻辑与排版对齐参考图：软件启动 → 产品新建·管理（产品类型 / 产品规格 两分支）→ 设备启动
%% 预览：Typora / VS Code(Markdown Preview Mermaid Support) / mermaid.live
flowchart TD
    A["1、软件启动<br/>用户手动运行软件程序"] --> SUB

    subgraph SUB["2、产品新建·管理"]
        T["2.1 产品类型"]
        S["2.2 产品规格"]

        T --> T1["2.1.1 产品类型判断<br/>MLCC / 电阻 / 电感 / LED / 芯片"]
        T1 --> T2["2.1.2 检测项配方加载"]
        T2 --> T3["2.1.3 检测项配方设置"]

        S --> S0["可选产品规格<br/>0201 / 0402 / 0603 / 0805 / 1206"]
        S0 --> J{"规格兼容判断"}
        J -->|"兼容规格数 = 1"| C1["调用相机参数 1"]
        J -->|"兼容规格数 = 2（最多为 2）"| SG["规格 1 / 规格 2"]
        SG --> C2["调用相机参数 2"]
    end

    SRC["出厂标准化配置"] --> SRC1["出厂配置检测项（全部）"]
    SRC1 -.-> T2
    ALG["算法调整"] --> DEF["默认检测项（根据需求调整）"]
    DEF -.-> T3
    PRESET["出厂前配置好"] --> CAM["相机采图控制"]
    C1 --> CAM
    C2 --> CAM

    T3 --> G["3、设备启动"]
    CAM --> G

    classDef main fill:#FFF2CC,stroke:#D6B656,color:#7F6000;
    classDef op fill:#4A76C4,stroke:#2F5597,color:#FFFFFF;
    classDef preset fill:#93C47D,stroke:#6AA84F,color:#274E13;
    classDef aux fill:#E6E6E6,stroke:#999999,color:#444444,stroke-dasharray:4 3;
    classDef judge fill:#F4B6B6,stroke:#C00000,color:#7F0000;
    classDef camctl fill:#E6F4F1,stroke:#5BADA0,color:#1F6B5E;
    class A,G main;
    class T,S,T1,T2,T3,S0,C1,C2 op;
    class SRC,SRC1,PRESET preset;
    class ALG,DEF aux;
    class J,SG judge;
    class CAM camctl;
    style SUB fill:#FFF9E6,stroke:#D6B656,stroke-width:2px;
